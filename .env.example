# Flask Configuration
SECRET_KEY=dev-secret-key-change-in-production
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=True

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=LeadFlow Pro

# Clearbit API (optional - for enhanced enrichment)
CLEARBIT_API_KEY=

# Google Sheets Integration (bonus)
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=

# Google Drive Integration (bonus)
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_FOLDER_ID=

# Google Credentials (bonus)
# Place your service account JSON as credentials.json
GOOGLE_CREDENTIALS_FILE=credentials.json

# Report Configuration
REPORT_SENDER_NAME=LeadFlow Pro Analytics
REPORT_SENDER_TITLE=Business Intelligence Team